# =====================================================================
# .env.example — rama ai-microservices-disaster
# API pura de inteligencia (gateway + expert-service + ai-service) +
# Postgres(pgvector) + Redis. Sin Django, Next.js, MongoDB, Celery/RabbitMQ.
# Copia este archivo a .env y completa los valores.
# =====================================================================

# ---- Seguridad / JWT (OBLIGATORIO) ----
# El gateway es el unico emisor y verificador de JWT. Sin esto NO arranca.
SECRET_KEY=cambia-esto-por-un-secreto-largo
JWT_SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400

# ---- Cifrado de conversaciones (recomendado en produccion) ----
# Clave Fernet para cifrar messages/medical_context en Redis.
# Si se omite, se deriva de SECRET_KEY (NO recomendado en produccion).
# Generar una real: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_ENCRYPTION_KEY=

# ---- Secreto HMAC interno gateway<->ai-service (opcional, recomendado) ----
# Heredado del antiguo FLASK_API_KEY. Ya no es obligatorio para arrancar.
INTERNAL_SHARED_SECRET=

# ---- Redis (OBLIGATORIO) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esto
REDIS_DB_CONVERSATIONS=2
REDIS_DB_CONTEXT=2
REDIS_DB_EPHEMERAL=6

# ---- Postgres + pgvector (OBLIGATORIO) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medicheck
POSTGRES_USER=medicheck
POSTGRES_PASSWORD=cambia-esto

# ---- URLs internas de servicios ----
AI_SERVICE_URL=http://ai-service:5001
EXPERT_SERVICE_URL=http://expert-service:5002

# ---- Enfoque dual Venezuela / fuera de Venezuela ----
DEFAULT_USER_COUNTRY=VE
DISASTER_CONTEXT_LABEL=terremoto Venezuela 2026

# ---- AWS Bedrock (Claude + embeddings) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CLAUDE_MODEL_ID=
BEDROCK_CLAUDE_INFERENCE_PROFILE_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# ---- Limitador de concurrencia hacia Bedrock (anti-throttling / costos) ----
BEDROCK_MAX_CONCURRENCY=4
BEDROCK_ACQUIRE_TIMEOUT_SECONDS=30

# ---- WebSocket (gateway) ----
# El WS autentica con el MISMO JWT (mensaje type=auth con el token emitido por
# POST /auth/session). Variables de sesion/limite:
WS_AUTH_TTL_SECONDS=3600
WS_RATE_LIMIT_WINDOW_SECONDS=60
WS_RATE_LIMIT_MAX_MESSAGES=20
